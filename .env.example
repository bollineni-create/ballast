# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Alpaca PAPER trading keys (alpaca.markets > Paper Trading > API Keys).
# Ballast only ever talks to Alpaca's paper endpoint.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Optional: enables the AI strategy builder.
ANTHROPIC_API_KEY=
